*/

//Q1
let a = "bottle";
let b = 10;
console.log(a+b);   //bottle10

//Q2
console.log(typeof(a + b)); //string

//Q3
const items={
    name: "Harry",
    section: 1,
    ispriniciple : false
}
//items = 45; // cant add new number like this

//Q4
items['friend'] = "Anjali";
console.log(items);  // const is constant still able to add new key

//Q5
const dict = {
    ataraxia : "I just want a week away from the daily grind.",
    yakka : "work, especially hard work",
}

console.log(dict["yakka"]);
console.log(dict['yakka']);
//or
console.log(dict.yakka);

